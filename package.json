{
  "name": "citationpulse-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-api.ps1",
    "dev:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-worker.ps1",
    "prestack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-dev.ps1",
    "stack:run": "concurrently --kill-others-on-fail -n web,api,worker -c blue,magenta,green \"npm run dev -w citationpulse-web\" \"npm run dev:api\" \"npm run dev:worker\"",
    "stack": "npm run prestack && npm run stack:run",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-all.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
    "start:all": "npm run dev",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-all.ps1",
    "dev:stack": "npm run dev",
    "dev:web": "npm run dev -w citationpulse-web",
    "dev:geo:web": "npm run dev -w citationpulse-web",
    "build": "npm run build -w citationpulse-web",
    "build:web": "npm run build -w citationpulse-web",
    "build:geo:web": "npm run build -w citationpulse-web",
    "start": "npm run start -w citationpulse-web",
    "start:web": "npm run start -w citationpulse-web",
    "lint": "npm run lint -w citationpulse-web",
    "lint:geo:web": "npm run lint -w citationpulse-web",
    "dev:restart": "kill-port 3000 8000 && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "kill-port": "^2.0.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
