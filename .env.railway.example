# Railway production template — copy values into Railway service variables (never commit real secrets).

# --- API service (root: apps/api) ---
ENVIRONMENT=production
LOG_LEVEL=info
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Public landing funnel (no login required):
PUBLIC_ACCESS_MODE=true
AUTH_DISABLE_JWT=true
API_CORS_ORIGINS=https://your-web-service.up.railway.app
OPENROUTER_API_KEY=
# Optional: dedicated Celery worker (set on API when worker service exists)
# CELERY_USE_WORKER=1

# --- Worker service (root: apps/api, Dockerfile.worker) ---
# Same as API except no HTTP PORT binding required.

# --- Web service (root: apps/web) — required at Docker BUILD time ---
NEXT_PUBLIC_API_URL=https://your-api-service.up.railway.app
# Or same-origin proxy:
# NEXT_PUBLIC_API_URL=same-origin
# API_PROXY_TARGET=https://your-api-service.up.railway.app
# Baked into Docker build by default; set false to re-enable login in production:
NEXT_PUBLIC_SKIP_AUTH=true

# To require login again in production, set on Web build:
# NEXT_PUBLIC_SKIP_AUTH=false
# And on API: PUBLIC_ACCESS_MODE=false, AUTH_DISABLE_JWT=false, AUTH_JWT_SECRET=<32+ chars>
