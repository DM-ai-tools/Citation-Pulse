NEXT_PUBLIC_API_URL=http://localhost:8000
# Local dev without JWT (must match AUTH_DISABLE_JWT=true on API):
# AUTH_DISABLE_JWT=true
# NEXT_PUBLIC_AUTH_DISABLE_JWT=true
# NEXT_PUBLIC_AUTH_BYPASS=true
# Production: set AUTH_JWT_SECRET (server-only) to match API; do not use bypass flags.
AUTH_JWT_SECRET=
# Railway (recommended): browser calls /api/v1 on the web host; Next rewrites to FastAPI at build time.
# NEXT_PUBLIC_API_URL=same-origin
# API_PROXY_TARGET=https://your-api.up.railway.app
# If API_PROXY_TARGET is set and NEXT_PUBLIC_API_URL is empty at build, Docker defaults to same-origin.
# Workspace dashboard: optional pin to one scan (overrides latest landing-page scan in localStorage)
NEXT_PUBLIC_DASHBOARD_SCAN_ID=
NEXT_PUBLIC_DASHBOARD_BRAND_ID=
# If you have multiple brands, match one by site (e.g. firstpage.com.au)
NEXT_PUBLIC_DASHBOARD_SITE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
