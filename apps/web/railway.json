{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -lc \"cd /app && npm run start -- --hostname 0.0.0.0 --port $PORT\"",
    "healthcheckPath": "/landing",
    "restartPolicyType": "ON_FAILURE"
  }
}
