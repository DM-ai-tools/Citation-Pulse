{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "frontend/Dockerfile"
  },
  "deploy": {
    "startCommand": "npm run start -- --hostname 0.0.0.0 --port $PORT",
    "healthcheckPath": "/login",
    "restartPolicyType": "ON_FAILURE"
  }
}
