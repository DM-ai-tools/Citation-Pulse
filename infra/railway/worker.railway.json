{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile.worker"
  },
  "deploy": {
    "startCommand": "celery -A citationpulse.celery_app worker -Q default -l info --pool=solo",
    "restartPolicyType": "ON_FAILURE"
  }
}
