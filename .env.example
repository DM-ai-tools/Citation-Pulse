# --- Postgres (local docker-compose: port 5434) ---
DATABASE_URL=postgresql+psycopg://citationpulse:citationpulse@localhost:5434/citationpulse_geo

# --- Celery (Postgres-backed; no Redis required) ---
# Leave blank to derive from DATABASE_URL: sqla+<db_url> / db+<db_url>.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# In ENVIRONMENT=development, tasks run inside the API process by default (no worker needed).
# (Celery 5 only applies eager mode to .delay() / registered tasks — not send_task by name.)
# Set CELERY_USE_WORKER=1 and run: celery -A citationpulse.celery_app.celery_app worker -l info
# Or force: CELERY_TASK_ALWAYS_EAGER=false with a worker.
# CELERY_USE_WORKER=1
# CELERY_TASK_ALWAYS_EAGER=false

# --- SSE live scan stream ---
SSE_POLL_INTERVAL_S=0.6
SSE_KEEPALIVE_INTERVAL_S=15

# --- API ---
# Comma-separated browser origins. The API also allows dev regexes (loopback + common LAN IPs on :3000 when
# ENVIRONMENT is not production) so "Failed to fetch" from http://127.0.0.1:3000 vs Next "Network" URLs works.
# Production: list every deployed web origin here (and rebuild if needed).
API_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
INTERNAL_PHASE1=true
INTERNAL_API_KEY=

# --- Clerk (Phase 2 SaaS) ---
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Next.js (copy to apps/web/.env.local; see apps/web/.env.example) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_DASHBOARD_SCAN_ID=   # Optional: workspace dashboard KPIs = same payload as /report/<id>
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # Phase 2 Stripe.js / Checkout in browser

# --- Unified LLM gateway: OpenRouter (REQUIRED) ---
# All 4 AI engines (ChatGPT, Claude, Gemini, Perplexity) are routed through
# OpenRouter using a single API key. Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional analytics headers (leaderboard opt-in):
# OPENROUTER_HTTP_REFERER=https://citationpulse.local
# OPENROUTER_APP_TITLE=CitationPulse GEO

# --- Optional model overrides (OpenRouter slugs) ---
# CHATGPT_MODEL=openai/gpt-4o-mini:online
# CLAUDE_MODEL=anthropic/claude-3.5-haiku:online
# GEMINI_MODEL=google/gemini-2.0-flash-001:online
# PERPLEXITY_MODEL=perplexity/sonar
# SENTIMENT_MODEL=anthropic/claude-3.5-haiku

# --- Legacy provider keys (DEPRECATED — only used if OPENROUTER_API_KEY is empty) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# PERPLEXITY_API_KEY=
# CHATGPT_SESSION_TOKEN=

# --- Playwright / proxies (TDD §11: PROXY_URL; residential proxy for Google AIO) ---
PLAYWRIGHT_PROXY_SERVER=
# Optional remote browser (not yet read by Settings — wire when using Browserless):
# BROWSERLESS_TOKEN=
# BROWSERLESS_WS_URL=

# --- Cloudflare R2 (optional) — stores raw OpenRouter JSON for debugging only.
# Scans, citations, and reports work without R2; leave blank in local dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_RAW_PAYLOADS=citationpulse-raw
R2_PUBLIC_BASE_URL=

# --- Alerts ---
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERTS_FROM_EMAIL=alerts@example.com

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SAAS=
STRIPE_PRICE_DFY=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Canary ---
CANARY_BRAND_ID=

# --- Gap scoring ---
GAP_ABSENCE_RUN_THRESHOLD=3

# --- DataForSEO (optional) — estimated monthly search volume by geo ---
# Dashboard: https://app.dataforseo.com/api-access — use HTTP Basic (login + password).
# API: https://docs.dataforseo.com/v3/keywords_data/google_ads/search_volume/live/
# Geo: pass ``location_code`` (DataForSEO location id). Examples: 2840 = United States,
# 2036 = Australia. Full list: Keywords Data → Google Ads → Locations in their docs.
# Call from a logged-in session: POST /api/v1/operator/keywords/search-volume
#   JSON: {"keywords":["seo agency melbourne"],"location_code":2036,"language_code":"en"}
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Partner API HMAC (Phase 3) ---
PUBLIC_API_HMAC_SECRET=
