# --- Postgres (local docker-compose: port 5434) ---
DATABASE_URL=postgresql+psycopg://citationpulse:citationpulse@localhost:5434/citationpulse_geo

# --- Celery (Postgres-backed; no Redis required) ---
# Leave blank to derive from DATABASE_URL: sqla+<db_url> / db+<db_url>.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Redis cache (optional — used by Top Gap Opportunities) ---
# Caches DataForSEO lookups for 7 days keyed by (variant, locale) to avoid
# repeated API billing. Leave blank to fall back to an in-process LRU cache.
# Example:
#   REDIS_URL=redis://default:password@redis.your-host.com:6379/0
REDIS_URL=

# --- Top Gap Opportunities tuning (defaults shown) ---
# DEMAND_MIN_LITERAL_VOLUME=50
# DEMAND_MIN_VARIANT_VOLUME=50
# DEMAND_HIGH_VOLUME=5000
# DEMAND_MEDIUM_VOLUME=500
# In ENVIRONMENT=development, tasks run inside the API process by default (no worker needed).
# On Railway (API-only deploy), the API auto-runs tasks inline unless CELERY_USE_WORKER=1.
# (Celery 5 only applies eager mode to .delay() / registered tasks — not send_task by name.)
# Three-service Railway (recommended): API + worker + web — set CELERY_USE_WORKER=1 on API and worker.
# Two-service Railway (API + web only): leave CELERY_USE_WORKER unset; redeploy API after env changes.
# Or force inline: CELERY_TASK_ALWAYS_EAGER=true
# CELERY_USE_WORKER=1
# CELERY_TASK_ALWAYS_EAGER=false

# --- SSE live scan stream ---
SSE_POLL_INTERVAL_S=0.6
SSE_KEEPALIVE_INTERVAL_S=15

# --- API ---
# Comma-separated browser origins. The API also allows dev regexes (loopback + common LAN IPs on :3000 when
# ENVIRONMENT is not production) so "Failed to fetch" from http://127.0.0.1:3000 vs Next "Network" URLs works.
# Production: list every deployed web origin here (and rebuild if needed).
API_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
INTERNAL_PHASE1=true
INTERNAL_API_KEY=

# --- Native auth (email/password — used by /login, /signup, /admin) ---
# Required in production. API creates users/sessions tables on startup.
AUTH_JWT_SECRET=change-me-use-openssl-rand-hex-32
AUTH_JWT_EXPIRE_HOURS=72
# First admin account (seeded once if no admin exists):
AUTH_ADMIN_NAME=Traffic-Radius
AUTH_ADMIN_EMAIL=traffic-radius@trafficradius.com
AUTH_ADMIN_PASSWORD=change-me-strong-password

# --- Clerk (optional — legacy SaaS org auth) ---
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Next.js (copy to apps/web/.env.local; see apps/web/.env.example) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_DASHBOARD_SCAN_ID=   # Optional: workspace dashboard KPIs = same payload as /report/<id>
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # Phase 2 Stripe.js / Checkout in browser

# --- Hybrid LLM routing (parallel scan execution) ---
# ChatGPT + Claude run on your direct API keys (faster). Gemini + Perplexity use OpenRouter.
# All engine calls for a scan run in parallel (SCAN_PARALLEL_ENGINES=true).
#
# Required for ChatGPT column:
OPENAI_API_KEY=
# Required for Claude column (direct Anthropic). If credits are exhausted, either add
# billing at console.anthropic.com or set CLAUDE_PREFER_OPENROUTER=true (uses OpenRouter below).
ANTHROPIC_API_KEY=
CLAUDE_PREFER_OPENROUTER=false
# Required for Gemini + Perplexity columns (also used for Claude when direct Anthropic fails or prefer flag is true):
OPENROUTER_API_KEY=
#
# Optional analytics headers (OpenRouter leaderboard opt-in):
# OPENROUTER_HTTP_REFERER=https://citationpulse.local
# OPENROUTER_APP_TITLE=CitationPulse GEO
#
# Direct API model ids (when keys above are set):
# OPENAI_DIRECT_MODEL=gpt-4o-mini-search-preview
# ANTHROPIC_DIRECT_MODEL=claude-3-5-haiku-latest
#
# OpenRouter slugs (Gemini + Perplexity; fallback if direct keys missing):
# CHATGPT_MODEL=openai/gpt-4o-mini:online
# CLAUDE_MODEL=anthropic/claude-3.5-haiku:online
# GEMINI_MODEL=google/gemini-2.0-flash-001:online
# PERPLEXITY_MODEL=perplexity/sonar
# SENTIMENT_MODEL=anthropic/claude-3.5-haiku
#
# Parallel execution (default on — all engines per scan at once):
# SCAN_PARALLEL_ENGINES=true
# SCAN_PARALLEL_MAX_CONCURRENT=8
#
# Legacy / unused for scans:
# GOOGLE_AI_API_KEY=
# PERPLEXITY_API_KEY=
# CHATGPT_SESSION_TOKEN=

# --- Playwright / proxies (TDD §11: PROXY_URL; residential proxy for Google AIO) ---
PLAYWRIGHT_PROXY_SERVER=
# Optional remote browser (not yet read by Settings — wire when using Browserless):
# BROWSERLESS_TOKEN=
# BROWSERLESS_WS_URL=

# --- Cloudflare R2 (optional) — stores raw OpenRouter JSON for debugging only.
# Scans, citations, and reports work without R2; leave blank in local dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_RAW_PAYLOADS=citationpulse-raw
R2_PUBLIC_BASE_URL=

# --- Alerts ---
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERTS_FROM_EMAIL=alerts@example.com

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SAAS=
STRIPE_PRICE_DFY=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Canary ---
CANARY_BRAND_ID=

# --- Competitor discovery (POST /api/v1/competitors/analyze) ---
# Competitor landscape (POST /scans auto-discover + /competitors/analyze) — OpenRouter slug
COMPETITOR_DISCOVERY_MODEL=perplexity/sonar
COMPETITOR_DISCOVERY_MAX_TOKENS=8192
# COMPETITOR_ANALYZE_RATE_LIMIT_PER_HOUR=12

# --- Gap scoring ---
GAP_ABSENCE_RUN_THRESHOLD=3

# --- DataForSEO (optional) — estimated monthly search volume by geo ---
# Dashboard: https://app.dataforseo.com/api-access — use HTTP Basic (login + password).
# API: https://docs.dataforseo.com/v3/keywords_data/google_ads/search_volume/live/
# Geo: pass ``location_code`` (DataForSEO location id). Examples: 2840 = United States,
# 2036 = Australia. Full list: Keywords Data → Google Ads → Locations in their docs.
# Call from a logged-in session: POST /api/v1/operator/keywords/search-volume
#   JSON: {"keywords":["seo agency melbourne"],"location_code":2036,"language_code":"en"}
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Partner API HMAC (Phase 3) ---
PUBLIC_API_HMAC_SECRET=
